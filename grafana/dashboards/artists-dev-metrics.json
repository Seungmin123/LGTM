          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-ds"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"artist-back\", deployment_environment=\"$env\", http_status_code=~\"5..\"}[5m])) / sum(rate(http_server_duration_milliseconds_count{service_name=\"artist-back\", deployment_environment=\"$env\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "에러율 (5xx)",
