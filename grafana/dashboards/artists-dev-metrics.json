  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-ds"
      },
      "description": "⚠ 메트릭/라벨 이름은 OTel→Mimir 변환 추정값입니다. 최초 데이터 유입 후 Explore→Mimir(Metrics browser)에서 실제 이름 확인 후 교체하세요.",
      "fieldConfig": {
        "defaults": {}
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-ds"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"artist-back\", deployment_environment=\"$env\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "요청률 (req/s)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-ds"
      },
      "description": "⚠ 메트릭/라벨 이름은 OTel→Mimir 변환 추정값입니다. 최초 데이터 유입 후 Explore→Mimir(Metrics browser)에서 실제 이름 확인 후 교체하세요.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
