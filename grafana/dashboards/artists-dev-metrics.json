      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-ds"
          },
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count{service_name=\"artist-back\", deployment_environment=\"$env\"}[5m]))",
          "legendFormat": "{{http_status_code}}",
          "refId": "A"
        }
      ],
      "title": "상태코드별 요청률 (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-ds"
      },
      "description": "선택 기간($__range) 동안 경로(http_route)별 평균 응답시간 상위 30개. 평균 = rate(_sum)/rate(_count). ⚠ 메트릭/라벨 이름은 OTel→Mimir 변환 추정값 — 데이터 유입 후 http_route 라벨명 확인 후 교정.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "mode": "gradient",
              "type": "color-background"
            }
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "평균 응답시간(ms)"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-ds"
          },
          "expr": "topk(30, sum by (http_target, http_method) (rate(http_server_duration_milliseconds_sum{service_name=\"artist-back\", deployment_environment=\"$env\", http_method!=\"OPTIONS\"}[$__range])) / (sum by (http_target, http_method) (rate(http_server_duration_milliseconds_count{service_name=\"artist-back\", deployment_environment=\"$env\", http_method!=\"OPTIONS\"}[$__range])) > 0))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "평균 응답시간 Top 30 (경로별)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "평균 응답시간(ms)",
              "http_method": "메서드",
              "http_target": "경로"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-ds"
      },
      "description": "선택 기간($__range) 동안 경로(http_route)별 P95 응답시간 상위 30개. histogram_quantile(0.95) by (le, http_route). ⚠ 메트릭/라벨 이름은 OTel→Mimir 변환 추정값 — 데이터 유입 후 http_route 라벨명 확인 후 교정.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "mode": "gradient",
              "type": "color-background"
            }
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 8,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "P95 응답시간(ms)"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-ds"
          },
          "expr": "topk(30, histogram_quantile(0.95, sum by (le, http_target, http_method) (rate(http_server_duration_milliseconds_bucket{service_name=\"artist-back\", deployment_environment=\"$env\", http_method!=\"OPTIONS\"}[$__range]))) and (sum by (http_target, http_method) (rate(http_server_duration_milliseconds_count{service_name=\"artist-back\", deployment_environment=\"$env\", http_method!=\"OPTIONS\"}[$__range])) > 0))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "응답시간 P95 Top 30 (경로별)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "P95 응답시간(ms)",
              "http_method": "메서드",
              "http_target": "경로"
            }
          }
        }
      ],
      "type": "table"
    }
