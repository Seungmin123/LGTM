          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"artist-back\", deployment_environment=\"$env\", http_method!=\"OPTIONS\"}[5m])))",
          "legendFormat": "p50",
